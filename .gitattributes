# System Programming and Compiler Construction - Academic Repository
# Professional .gitattributes for scholarly archiving

# Set default behavior to automatically normalize line endings
* text=auto

# Ensure text and source files use LF on checkout
*.md text eol=lf
*.txt text eol=lf
*.c text eol=lf diff=cpp
*.cpp text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.java text eol=lf diff=java
*.py text eol=lf diff=python
*.l text eol=lf
*.y text eol=lf
*.cff text eol=lf
LICENSE text eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary

# Improve diff handling
*.md text diff=markdown
