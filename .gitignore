# System Programming and Compiler Construction - Academic Repository
# Specialized .gitignore for compilers and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# C / C++ Build Artifacts
*.exe
*.o
*.obj
*.dll
*.out
*.a
*.so
*.dylib
Debug/
Release/
x64/
x86/

# Java Build Artifacts
*.class
*.jar
*.war
*.ear
*.ctxt

# Python Build Artifacts
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env

# Lex / Yacc (Intermediate generated files)
y.output
lex.yy.c
y.tab.c
y.tab.h

# Assembly / System Programming specific output
*.lst
*.map

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# Temporary and Cache files
*.tmp
*.log
.cache/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
